# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development

# Database
# ─────────────────────────────────────────────────────────────────────────────
# Backend MUST use splitzy_app (or any role with NOBYPASSRLS). RLS is enforced.
#
# NEVER put neondb_owner (or any BYPASSRLS role) here — the API would skip policies.
#
# One-time: create role → database/setup-splitzy-app-role.sql (Neon SQL editor, as owner)
#
# Deploy ./database/deploy.sh may temporarily use the owner URL in the shell only.
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://splitzy_app:YOUR_PASSWORD@YOUR_HOST/neondb?sslmode=require

# JWT Secret Key (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=your_jwt_secret_key_here

# Frontend URLs for CORS (comma-separated). Required when FLASK_ENV is not development.
FRONTEND_URL=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
# FRONTEND_URL=https://your-frontend-domain.com

# PORT for deployment (default: 5000)
PORT=5000
